COOKIE_SECRET=change_me_cookie_secret_min_32_chars_long_random_string
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_random_string
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_random_string
INTERNAL_AI_API_SECRET=change_me_internal_service_secret_min_32_chars_long_random_string
INTERNAL_API_SECRET=change_me_api_to_ai_service_secret_min_32_chars_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost/admin
CORS_EXTRA_ORIGINS=


PAYMENT_PROVIDER=manual
PAYMENT_INTENT_TTL_MINUTES=1440
PLATFORM_FEE_PERCENT=10
MANUAL_PAYMENT_MAX_SUBMISSIONS=5
MANUAL_PAYMENT_ACCOUNTS='[{"method":"BANK_TRANSFER","label":"Bank transfer","accountNumber":"change_me_account_number","accountName":"change_me_account_holder"}]'


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
EMAIL_FROM=ReduCera <onboarding@resend.dev>
OTP_DEV_MODE=false
SEED_ACCOUNT_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_NAME=
SEED_USER_PASSWORD=

ARCJET_KEY=

LOG_LEVEL=info

NEST_API=http://api:3002/api/v1
AI_URL=http://ai-api:3003/ai/v1

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=reducera-embedding
QDRANT_MEMORY_COLLECTION=reducera-memory

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.mistral.ai/v1
OPENAI_MODEL_FLASH=mistral-small-latest
OPENAI_MODEL_THINKING=magistral-medium-latest
OPENAI_MAX_TOKENS=8192
OPENAI_THINKING_MAX_TOKENS=16000
OPENAI_FLASH_TEMPERATURE=

HF_EMBEDDING_MODEL=BAAI/bge-m3
HF_EMBEDDING_URL=https://router.huggingface.co/hf-inference/models/{model}/pipeline/feature-extraction
EMBEDDING_DIM=1024
EMBEDDING_PROVIDER=huggingface
LOCAL_EMBEDDING_MODEL=/models/bge-m3
LOCAL_EMBEDDING_THREADS=4
LOCAL_EMBEDDING_MAX_LENGTH=512
LOCAL_EMBEDDING_PRELOAD=false
LOCAL_EMBEDDING_ALLOW_DOWNLOAD=false
EMBEDDING_MODELS_DIR=./models

TAVILY_API_KEY=

HF_TOKEN=

CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_CHAT_WORKER_CONCURRENCY=2

# Resource URL allow-list (SSRF + RAG-poisoning defense)
RESOURCE_ALLOWLIST_HOSTS=cdn.reducera.example.com,docs.reducera.example.com
RESOURCE_ALLOWLIST_SCHEMES=https
RESOURCE_ALLOWLIST_LOCAL=false

# AI API rate limiting (per-IP, token bucket)
AI_API_RATE_LIMIT=60
AI_API_RATE_BURST=10

NUXT_PUBLIC_API_URL=http://localhost/api/v1
NUXT_PUBLIC_AI_URL=http://localhost/ai/v1
NUXT_PUBLIC_SITE_URL=http://localhost

API_URL_INTERNAL=http://api:3002