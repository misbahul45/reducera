WEB_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

PUBLIC_API_URL=http://localhost/api/v1
PUBLIC_AI_URL=http://localhost/ai/v1
PUBLIC_WEB_URL=http://localhost

